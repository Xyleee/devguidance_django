# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-domain.onrender.com,127.0.0.1,localhost

# Database (will be automatically set by Render for PostgreSQL)
DATABASE_URL=postgres://username:password@hostname:port/database_name

# Individual database settings (optional if using DATABASE_URL)
DB_NAME=devguidance
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your_db_host
DB_PORT=5432

# Render specific (automatically set by Render)
RENDER=True
RENDER_EXTERNAL_HOSTNAME=your-app-name.onrender.com 